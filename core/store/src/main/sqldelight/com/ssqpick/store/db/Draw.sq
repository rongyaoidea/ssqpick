-- 开奖记录。code 为期号字符串，如 2026115。
-- 注意：SQLDelight 的 INTEGER 默认映射为 Kotlin Long，这里保持 Long，转换在 Mappers 里做。
CREATE TABLE draw (
    code TEXT NOT NULL PRIMARY KEY,
    date TEXT NOT NULL,
    red TEXT NOT NULL,
    blue INTEGER NOT NULL,
    sales INTEGER NOT NULL DEFAULT 0,
    pool_amount INTEGER NOT NULL DEFAULT 0,
    first_prize_amount INTEGER NOT NULL DEFAULT 0,
    second_prize_amount INTEGER NOT NULL DEFAULT 0
);

-- 开奖日期用于按年月查询，故单独建索引。
CREATE INDEX draw_date ON draw (date DESC);

insertOrIgnoreDraw:
INSERT OR IGNORE INTO draw (code, date, red, blue, sales, pool_amount, first_prize_amount, second_prize_amount)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllDraws:
SELECT * FROM draw ORDER BY date DESC;

selectDrawCount:
SELECT COUNT(*) FROM draw;

selectNewestDraw:
SELECT * FROM draw ORDER BY date DESC LIMIT 1;
